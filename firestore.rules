rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ibrahimdurosimi@gmail.com' || 
        request.auth.token.email == 'admin@lotustribe.com'
      );
    }

    // User profiles & Leaderboard
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow delete: if isAdmin();
      }
    }

    // Collection Group query for transactions across all users (Admin dashboard)
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && request.resource != null && request.resource.data.userId == request.auth.uid);
    }

    // Educational Courses catalog
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course modules
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Community events & webinars
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Q&A - Support 'questions' collection used by Community.tsx
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
    }

    // Fallback alias for community_questions
    match /community_questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
    }
  }
}
