{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing their quiz result and risk profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "description": "The user's email."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "riskProfile": {
          "type": "string",
          "enum": ["Steady Saver", "Calculated Thinker", "Risk Taker"],
          "description": "The determined risk profile."
        },
        "quizCompleted": {
          "type": "boolean"
        },
        "xp": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "completedLessons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "completedCourses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "badges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fifBalance": {
          "type": "number"
        },
        "halalBalance": {
          "type": "number"
        },
        "totalInvested": {
          "type": "number"
        },
        "createdAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["email", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles and their investment vibe check results."
    }
  }
}
